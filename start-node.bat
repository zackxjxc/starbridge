@echo off
setlocal
rem Generated by Codex: launch the local StarBridge node.
chcp 65001 >nul
title StarBridge 设备中心
cd /d "%~dp0"

if not exist "state\runtime\frpc.exe" echo [警告] 缺少 state\runtime\frpc.exe，只能测试控制面。

set "STARBRIDGE_NODE_DIR=state\node"
if not exist "state\node" if exist "state\controller\identity.json" set "STARBRIDGE_NODE_DIR=state\controller"
cargo run -p starbridge-client -- --data-dir "%STARBRIDGE_NODE_DIR%"
if errorlevel 1 (
  echo.
  echo StarBridge 启动失败，请检查上方错误。
  pause
)
